{
  "name": "serverless-api-terraform",
  "version": "0.2.0",
  "description": "Production-ready serverless REST API template with Lambda, DynamoDB and Terraform modules",
  "license": "MIT",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "package": "npm run build && node scripts/package.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "demo": "tsx src/demo/local-server.ts",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/aws-lambda": "^8.10.140",
    "@types/node": "^20.14.0",
    "eslint": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Provokke/serverless-api-terraform.git"
  },
  "author": "Provokke",
  "keywords": [
    "serverless",
    "lambda",
    "terraform",
    "dynamodb",
    "api",
    "aws"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/handler.d.ts",
      "default": "./dist/src/handler.js"
    },
    "./validate": {
      "types": "./dist/src/validate.d.ts",
      "default": "./dist/src/validate.js"
    }
  },
  "main": "./dist/src/handler.js",
  "types": "./dist/src/handler.d.ts",
  "files": [
    "dist",
    "infra",
    "README.md",
    "LICENSE"
  ]
}
