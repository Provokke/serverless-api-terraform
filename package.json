{
  "name": "serverless-api-terraform",
  "version": "0.1.0",
  "description": "Serverless REST API (Lambda, API Gateway HTTP API, DynamoDB) in TypeScript with Terraform modules and least-privilege IAM.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "package": "npm run build && node scripts/package.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "demo": "tsx src/demo/local-server.ts",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/aws-lambda": "^8.10.140",
    "@types/node": "^20.14.0",
    "eslint": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  }
}
